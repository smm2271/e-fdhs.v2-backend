# Application PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=e_fdhs
DB_USER=postgres
DB_PASSWORD=change-me

# HttpOnly session-cookie duration in hours
AUTH_SESSION_TTL_HOURS=24
# Renew only after entering this window before normal expiry.
AUTH_SESSION_RENEWAL_WINDOW_HOURS=12
# Default per-session force_ttl_hours assigned when a token is issued.
AUTH_SESSION_FORCE_TTL_HOURS=720

# Dedicated PostgreSQL database for integration tests
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=e_fdhs_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=change-me
